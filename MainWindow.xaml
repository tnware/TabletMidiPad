<Window x:Class="TabletMidiPad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tablet MIDI Pad"
        Width="1280"
        Height="780"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#111111">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveCommand_Executed"/>
    </Window.CommandBindings>
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#171717"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#343434"/>
        <SolidColorBrush x:Key="FieldBrush" Color="#202020"/>
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#454545"/>
        <SolidColorBrush x:Key="FieldForegroundBrush" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="MutedForegroundBrush" Color="#B8B8B8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#C96E2D"/>
        <SolidColorBrush x:Key="AccentBrushHover" Color="#DD8240"/>
        <SolidColorBrush x:Key="AccentBrushPressed" Color="#A95A22"/>
        <SolidColorBrush x:Key="ScrollTrackBrush" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#545454"/>
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#6A6A6A"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource FieldForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource FieldForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Border x:Name="ComboBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Margin="8,5,6,5"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                        <Border Grid.Column="1"
                                                CornerRadius="0,4,4,0"
                                                Background="#2A2A2A">
                                            <Path Width="10"
                                                  Height="6"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Fill="#EAEAEA"
                                                  Data="M 0 0 L 10 0 L 5 6 Z"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Margin="0,6,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="#1D1D1D"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <ScrollViewer MaxHeight="260"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#6A6A6A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger SourceName="DropDownToggle" Property="IsChecked" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Background" Value="#1D1D1D"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#363636"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#5F3317"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentBrushHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentBrushPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C0C0C0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="16"
                                    Height="16"
                                    CornerRadius="3"
                                    Background="#202020"
                                    BorderBrush="#4D4D4D"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Visibility="Collapsed"
                                      Stroke="#F6F6F6"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 3 9 L 7 13 L 14 5"/>
                            </Border>
                            <ContentPresenter Grid.Column="2"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#7A7A7A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.45"/>
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource FieldForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#282828"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3D2A1A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RepeatButton" x:Key="ScrollBarPageButtonStyle">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Margin="2"
                                CornerRadius="6"
                                Background="{StaticResource ScrollThumbBrush}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource ScrollThumbHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Background" Value="{StaticResource ScrollTrackBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="Width" Value="Auto"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top"
              Background="#1A1A1A"
              Foreground="#E0E0E0"
              Padding="4,2">
            <Menu.Resources>
                <!-- Top-level menu items (File, Device, Help) -->
                <Style x:Key="TopLevelMenuItem" TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#E0E0E0"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="Border"
                                        Background="Transparent"
                                        Padding="8,4">
                                    <ContentPresenter ContentSource="Header"
                                                      RecognizesAccessKey="True"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#2E2E2E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Top-level menu items with submenus -->
                <Style x:Key="TopLevelMenuItemWithSub" TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#E0E0E0"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="Border"
                                        Background="Transparent"
                                        Padding="8,4">
                                    <Grid>
                                        <ContentPresenter ContentSource="Header"
                                                          RecognizesAccessKey="True"/>
                                        <Popup x:Name="PART_Popup"
                                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                               Placement="Bottom"
                                               AllowsTransparency="True"
                                               Focusable="False"
                                               PopupAnimation="Fade">
                                            <Border Background="#1D1D1D"
                                                    BorderBrush="#454545"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="0,4">
                                                <StackPanel IsItemsHost="True"
                                                            KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#2E2E2E"/>
                                    </Trigger>
                                    <Trigger Property="IsSubmenuOpen" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#2E2E2E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Submenu items (the actual clickable items in dropdowns) -->
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#E0E0E0"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="Border"
                                        Background="Transparent"
                                        Padding="24,7,32,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Grid.Column="0"
                                                          ContentSource="Header"
                                                          RecognizesAccessKey="True"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{TemplateBinding InputGestureText}"
                                                   Foreground="#808080"
                                                   Margin="24,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#363636"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="#707070"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style TargetType="Separator">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Separator">
                                <Border Margin="8,4"
                                        BorderBrush="#3A3A3A"
                                        BorderThickness="0,1,0,0"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Menu.Resources>
            <MenuItem Header="_File"
                      Style="{StaticResource TopLevelMenuItemWithSub}">
                <MenuItem Header="_Save Settings"
                          Click="MenuSaveSettings_Click"
                          InputGestureText="Ctrl+S"/>
                <MenuItem Header="_Reset to Defaults"
                          Click="MenuResetDefaults_Click"/>
                <Separator/>
                <MenuItem Header="_Preferences..."
                          Click="MenuPreferences_Click"/>
                <Separator/>
                <MenuItem Header="E_xit"
                          Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Device"
                      Style="{StaticResource TopLevelMenuItemWithSub}">
                <MenuItem Header="_Refresh Wacom Status"
                          Name="MenuRefreshWacom"
                          Click="MenuRefreshWacom_Click"/>
                <MenuItem Header="Reconnect _Pen Input"
                          Click="MenuReconnectPen_Click"/>
                <MenuItem Header="_Start Wacom Service"
                          Name="MenuStartWacomService"
                          Click="MenuStartWacomService_Click"/>
                <Separator/>
                <MenuItem Name="MenuWacomServiceStatus"
                          Header="Service: checking..."
                          IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="_Help"
                      Style="{StaticResource TopLevelMenuItemWithSub}">
                <MenuItem Header="_About"
                          Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="#1A1A1A"
                BorderBrush="#2A2A2A"
                BorderThickness="0,0,0,1"
                Padding="6,3">
            <Border.Resources>
                <Style x:Key="ToolbarButton" TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#C0C0C0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}"
                                        CornerRadius="3">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="ToolbarToggle" TargetType="ToggleButton">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#808080"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}"
                                        CornerRadius="3"
                                        BorderThickness="1"
                                        BorderBrush="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#2D2117"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#5A3A1E"/>
                                        <Setter Property="Foreground" Value="#D4A060"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="ToolbarSep" TargetType="Border">
                    <Setter Property="Width" Value="1"/>
                    <Setter Property="Background" Value="#2E2E2E"/>
                    <Setter Property="Margin" Value="4,2"/>
                </Style>
            </Border.Resources>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButton}"
                        Content="Save"
                        Click="MenuSaveSettings_Click"/>
                <Border Style="{StaticResource ToolbarSep}"/>
                <Button Style="{StaticResource ToolbarButton}"
                        Content="Add Zone"
                        Click="AddZoneButton_Click"/>
                <Button Style="{StaticResource ToolbarButton}"
                        Content="Auto Tile"
                        Click="AutoLayoutButton_Click"/>
                <Border Style="{StaticResource ToolbarSep}"/>
                <!-- Pressure split button: toggle + curve dropdown -->
                <Border x:Name="PressureSplitBorder"
                        CornerRadius="3"
                        BorderThickness="1"
                        BorderBrush="Transparent"
                        Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Name="ToolbarPressureToggle"
                                      Click="ToolbarPressureToggle_Click">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#808080"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Bd"
                                                        Background="Transparent"
                                                        Padding="8,4,5,4">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Foreground" Value="#D4A060"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                            <TextBlock Name="ToolbarPressureLabel"
                                       Text="Pressure"
                                       FontSize="11"/>
                        </ToggleButton>
                        <Border Width="1"
                                Background="#2E2E2E"
                                Margin="0,3"/>
                        <Button Name="ToolbarPressureCurveDropdown"
                                Click="ToolbarPressureCurveDropdown_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#808080"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="Transparent"
                                                        Padding="5,4,7,4">
                                                    <Path Width="7"
                                                          Height="4"
                                                          Fill="{TemplateBinding Foreground}"
                                                          Data="M 0 0 L 7 0 L 3.5 4 Z"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        <Button.ContextMenu>
                            <ContextMenu Name="PressureCurveMenu">
                                <ContextMenu.Resources>
                                    <Style TargetType="ContextMenu">
                                        <Setter Property="Background" Value="#1D1D1D"/>
                                        <Setter Property="BorderBrush" Value="#454545"/>
                                        <Setter Property="Foreground" Value="#E0E0E0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ContextMenu">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="0,4">
                                                        <StackPanel IsItemsHost="True"
                                                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Foreground" Value="#E0E0E0"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <Border x:Name="Bd"
                                                            Background="Transparent"
                                                            Padding="24,6,32,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="18"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ContentPresenter Grid.Column="0"
                                                                              ContentSource="Icon"
                                                                              VerticalAlignment="Center"/>
                                                            <ContentPresenter Grid.Column="1"
                                                                              ContentSource="Header"
                                                                              RecognizesAccessKey="True"
                                                                              VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#363636"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem Header="Linear"
                                          Click="PressureCurveLinear_Click"/>
                                <MenuItem Header="Logarithmic"
                                          Click="PressureCurveLogarithmic_Click"/>
                                <MenuItem Header="Exponential"
                                          Click="PressureCurveExponential_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    </StackPanel>
                </Border>
                <Border x:Name="InputBackendSplitBorder"
                        CornerRadius="3"
                        BorderThickness="1"
                        BorderBrush="Transparent"
                        Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <Button Name="ToolbarInputBackendButton"
                                Style="{StaticResource ToolbarButton}"
                                Padding="8,4"
                                Click="ToolbarInputBackendCycle_Click">
                            <TextBlock Name="ToolbarInputBackendLabel"
                                       Text="Input (Auto)"
                                       FontSize="11"/>
                        </Button>
                        <Border Width="1"
                                Margin="2,3"
                                Background="#2E2E2E"/>
                        <Button Style="{StaticResource ToolbarButton}"
                                Padding="6,4"
                                Click="ToolbarInputBackendDropdown_Click">
                            <TextBlock Text="▾"
                                       FontSize="11"/>
                            <Button.ContextMenu>
                                <ContextMenu Name="InputBackendMenu"
                                             Background="#1D1D1D"
                                             BorderBrush="#454545"
                                             BorderThickness="1">
                                    <ContextMenu.Resources>
                                        <Style TargetType="ContextMenu">
                                            <Setter Property="Background" Value="#1D1D1D"/>
                                            <Setter Property="BorderBrush" Value="#454545"/>
                                            <Setter Property="Foreground" Value="#E0E0E0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ContextMenu">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="0,4">
                                                            <StackPanel IsItemsHost="True"
                                                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Foreground" Value="#E0E0E0"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="MenuItem">
                                                        <Border x:Name="Bd"
                                                                Background="Transparent"
                                                                Padding="24,6,32,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="18"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ContentPresenter Grid.Column="0"
                                                                                  ContentSource="Icon"
                                                                                  VerticalAlignment="Center"/>
                                                                <ContentPresenter Grid.Column="1"
                                                                                  ContentSource="Header"
                                                                                  RecognizesAccessKey="True"
                                                                                  VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#363636"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ContextMenu.Resources>
                                    <MenuItem Header="Auto"
                                              Click="InputBackendAuto_Click"/>
                                    <MenuItem Header="Wintab"
                                              Click="InputBackendWintab_Click"/>
                                    <MenuItem Header="Mouse"
                                              Click="InputBackendStylus_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Border>
                <ToggleButton Name="ToolbarZoneSwitchToggle"
                              Style="{StaticResource ToolbarToggle}"
                              Content="Free Switch"
                              Click="ToolbarZoneSwitchToggle_Click"/>
                <Border Style="{StaticResource ToolbarSep}"/>
                <Button Style="{StaticResource ToolbarButton}"
                        Content="Reconnect"
                        Click="MenuReconnectPen_Click"/>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="#161616"
                BorderBrush="#2A2A2A"
                BorderThickness="0,1,0,0"
                Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Name="StatusText"
                           Grid.Column="0"
                           Foreground="#C0C0C0"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Text="Waiting for MIDI port..."/>

                <Border Grid.Column="1"
                        Width="1"
                        Background="#2E2E2E"
                        Margin="12,0"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Name="ActiveZoneText"
                               Foreground="#C9A44A"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                    <Border Width="1"
                            Background="#2E2E2E"
                            Margin="12,0"
                            VerticalAlignment="Stretch"/>
                    <TextBlock Name="ValueText"
                               Foreground="#909090"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Text="X: -  Y: -  P: -"/>
                    <Border Width="1"
                            Background="#2E2E2E"
                            Margin="12,0"
                            VerticalAlignment="Stretch"/>
                    <TextBlock Name="PenButtonsText"
                               Foreground="#7DA88A"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Text="Pen: -"/>
                    <Border Width="1"
                            Background="#2E2E2E"
                            Margin="12,0"
                            VerticalAlignment="Stretch"/>
                    <TextBlock Name="ModifiersText"
                               Foreground="#8890B0"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Text="Mod: none"/>
                </StackPanel>

                <TextBlock Name="InputBackendText"
                           Grid.Column="3"
                           Foreground="#6A8FAA"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Margin="8,8,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Zone editor panel -->
            <Border Grid.Column="0"
                    Background="#171717"
                    BorderBrush="#2A2A2A"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Zones"
                                   Foreground="#E0E0E0"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <TextBlock Name="RoutingText"
                                   Foreground="#707070"
                                   FontSize="11"
                                   Margin="0,4,0,10"
                                   TextWrapping="Wrap"/>

                        <WrapPanel Margin="0,0,0,8">
                            <Button Name="AutoLayoutButton"
                                    Margin="0,0,6,0"
                                    Padding="10,6"
                                    Click="AutoLayoutButton_Click"
                                    Content="Auto Tile"/>
                            <Button Name="AddZoneButton"
                                    Margin="0,0,6,0"
                                    Padding="10,6"
                                    Click="AddZoneButton_Click"
                                    Content="Add"/>
                            <Button Name="RemoveZoneButton"
                                    Padding="10,6"
                                    Click="RemoveZoneButton_Click"
                                    Content="Remove"/>
                        </WrapPanel>

                        <TextBlock Text="Layout"
                                   Foreground="#808080"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Max Rows"
                                           Foreground="#808080"
                                           FontSize="11"/>
                                <TextBox Name="MaxZoneRowsTextBox"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Max Per Row"
                                           Foreground="#808080"
                                           FontSize="11"/>
                                <TextBox Name="MaxZonesPerRowTextBox"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <ListBox Name="ZoneListBox"
                                 Height="120"
                                 SelectionChanged="ZoneListBox_SelectionChanged"/>

                        <!-- Selected zone properties -->
                        <Border Margin="0,12,0,0"
                                BorderBrush="#2A2A2A"
                                BorderThickness="0,1,0,0"
                                Padding="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="ZoneNameTextBox"
                                             Grid.Column="0"/>
                                    <CheckBox Name="ZoneEnabledCheckBox"
                                              Grid.Column="1"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              Content="On"/>
                                </Grid>

                                <TextBlock Text="MIDI"
                                           Foreground="#808080"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,14,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Ch"
                                                   Foreground="#808080"
                                                   FontSize="11"/>
                                        <ComboBox Name="ZoneChannelComboBox"
                                                  Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CC X"
                                                   Foreground="#808080"
                                                   FontSize="11"/>
                                        <TextBox Name="ZoneCcXTextBox"
                                                 Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="CC Y"
                                                   Foreground="#808080"
                                                   FontSize="11"/>
                                        <TextBox Name="ZoneCcYTextBox"
                                                 Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="CC P"
                                                   Foreground="#808080"
                                                   FontSize="11"/>
                                        <TextBox Name="ZoneCcPressureTextBox"
                                                 Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Bounds"
                                           Foreground="#808080"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,14,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Left"
                                                   Foreground="#808080"
                                                   FontSize="11"/>
                                        <TextBox Name="ZoneLeftTextBox"
                                                 Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Top"
                                                   Foreground="#808080"
                                                   FontSize="11"/>
                                        <TextBox Name="ZoneTopTextBox"
                                                 Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="W"
                                                   Foreground="#808080"
                                                   FontSize="11"/>
                                        <TextBox Name="ZoneWidthTextBox"
                                                 Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="H"
                                                   Foreground="#808080"
                                                   FontSize="11"/>
                                        <TextBox Name="ZoneHeightTextBox"
                                                 Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Options"
                                           Foreground="#808080"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,14,0,6"/>
                                <CheckBox Name="ZoneSendXCheckBox"
                                          Content="Send X"/>
                                <CheckBox Name="ZoneSendYCheckBox"
                                          Margin="0,6,0,0"
                                          Content="Send Y"/>
                                <CheckBox Name="ZoneInvertXCheckBox"
                                          Margin="0,6,0,0"
                                          Content="Invert X"/>
                                <CheckBox Name="ZoneInvertYCheckBox"
                                          Margin="0,6,0,0"
                                          Content="Invert Y"/>
                                <CheckBox Name="ZoneSendPressureCheckBox"
                                          Margin="0,6,0,0"
                                          Content="Send pressure"/>
                                <CheckBox Name="ZoneResetPressureCheckBox"
                                          Margin="0,6,0,0"
                                          Content="Reset pressure on release"/>
                            </StackPanel>
                        </Border>

                        <Button Margin="0,14,0,0"
                                Padding="10,7"
                                Click="MenuSaveSettings_Click"
                                Content="Apply Settings"/>

                        <TextBlock Name="SettingsResultText"
                                   Foreground="#6B9B6B"
                                   Margin="0,8,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>

                        <TextBlock Name="ConfigSummaryText"
                                   Foreground="#585858"
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Pad area -->
            <Border Grid.Column="2"
                    Background="#141414"
                    BorderBrush="#2A2A2A"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Canvas Name="Pad"
                            Background="Transparent"
                            SizeChanged="Pad_SizeChanged"
                            StylusDown="Pad_StylusDown"
                            StylusMove="Pad_StylusMove"
                            StylusUp="Pad_StylusUp"
                            MouseDown="Pad_MouseDown"
                            MouseMove="Pad_MouseMove"
                            MouseUp="Pad_MouseUp"/>

                    <Canvas Name="ZoneOverlayCanvas"
                            IsHitTestVisible="False"/>

                    <Ellipse Name="CursorDot"
                             Width="14"
                             Height="14"
                             Fill="#E0E0E0"
                             Opacity="0.85"
                             Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Loading overlay -->
            <Grid Name="LoadingOverlay"
                  Grid.ColumnSpan="3"
                  Background="#EE101010">
                <Border Width="400"
                        Padding="28"
                        CornerRadius="10"
                        Background="#1A1A1A"
                        BorderBrush="#2A2A2A"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Tablet MIDI Pad"
                                   Foreground="#E8E8E8"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Preparing controller surfaces and MIDI routing"
                                   Foreground="#808080"
                                   Margin="0,8,0,0"
                                   FontSize="13"
                                   HorizontalAlignment="Center"/>
                        <ProgressBar Name="LoadingProgressBar"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="6"
                                     Height="4"
                                     Margin="0,22,0,0"
                                     Foreground="#C96E2D"
                                     Background="#252525"/>
                        <TextBlock Name="LoadingTitleText"
                                   Text="Booting application"
                                   Foreground="#D0D0D0"
                                   Margin="0,18,0,0"
                                   FontSize="14"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Name="LoadingDetailText"
                                   Text="Creating the UI shell"
                                   Foreground="#707070"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
