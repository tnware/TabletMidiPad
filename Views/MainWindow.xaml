<Window x:Class="TabletMidiPad.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TabletMidiPad.Views"
        xmlns:vm="clr-namespace:TabletMidiPad.ViewModels"
        Title="Tablet MIDI Pad"
        Width="1280"
        Height="780"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Icon="{DynamicResource AppIcon}">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveCommand_Executed"/>
    </Window.CommandBindings>
    <Window.Resources>
        <Style x:Key="ZoneIconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="TopLevelMenuItemWithSub" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="10,5">
                            <Grid>
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"/>
                                <Popup x:Name="PART_Popup"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Bottom"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border Background="{StaticResource SurfaceRaisedBrush}"
                                            BorderBrush="{StaticResource PanelBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="0,4">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="24,8,32,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"/>
                                <TextBlock Grid.Column="1"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="{StaticResource TextSoftBrush}"
                                           Margin="24,0,0,0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Margin="8,4"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="0,1,0,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top"
              Background="{StaticResource SurfaceRaisedBrush}"
              Foreground="{StaticResource TextPrimaryBrush}"
              Padding="6,4">
            <MenuItem Header="_File"
                      Style="{StaticResource TopLevelMenuItemWithSub}">
                <MenuItem Header="_Save Settings"
                          Command="{Binding SaveSettingsCommand}"
                          InputGestureText="Ctrl+S"/>
                <MenuItem Header="_Reset to Defaults"
                          Command="{Binding ResetDefaultsCommand}"/>
                <Separator/>
                <MenuItem Header="_Preferences..."
                          Command="{Binding OpenPreferencesCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit"
                          Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Device"
                      Style="{StaticResource TopLevelMenuItemWithSub}">
                <MenuItem Header="_Refresh Wacom Status"
                          Name="MenuRefreshWacom"
                          Command="{Binding RefreshWacomStatusCommand}"/>
                <MenuItem Header="Reconnect _Pen Input"
                          Command="{Binding ReconnectPenCommand}"/>
                <MenuItem Header="_Start Wacom Service"
                          Name="MenuStartWacomService"
                          Command="{Binding StartWacomServiceCommand}"
                          IsEnabled="{Binding IsWacomServiceStartEnabled}"/>
                <Separator/>
                <MenuItem Name="MenuWacomServiceStatus"
                          Header="{Binding WacomServiceStatusHeader}"
                          IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="_Help"
                      Style="{StaticResource TopLevelMenuItemWithSub}">
                <MenuItem Header="_About"
                          Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <Border.Resources>
                <Style x:Key="ToolbarButton" TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Padding" Value="10,6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}"
                                        CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldPressedBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="ToolbarToggle" TargetType="ToggleButton">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Padding" Value="10,6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        BorderBrush="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSurfaceBrush}"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrushHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="ToolbarSep" TargetType="Border">
                    <Setter Property="Width" Value="1"/>
                    <Setter Property="Background" Value="{StaticResource PanelBorderBrush}"/>
                    <Setter Property="Margin" Value="6,2"/>
                </Style>
            </Border.Resources>
            <DockPanel>
            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Left">
                <Button Style="{StaticResource ToolbarButton}"
                        Content="Save"
                        Command="{Binding SaveSettingsCommand}"/>
                <Border Style="{StaticResource ToolbarSep}"/>
                <Button Style="{StaticResource ToolbarButton}"
                        Content="Add Zone"
                        Command="{Binding AddZoneCommand}"/>
                <Button Style="{StaticResource ToolbarButton}"
                        Content="Auto Tile"
                        Command="{Binding AutoLayoutCommand}"/>
                <Border Style="{StaticResource ToolbarSep}"/>
                <!-- Pressure split button: toggle + curve dropdown -->
                <Border x:Name="PressureSplitBorder"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="Transparent"
                        Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                <ToggleButton Name="ToolbarPressureToggle"
                              IsChecked="{Binding SendPressureGlobally, Mode=TwoWay}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Bd"
                                                        Background="Transparent"
                                                        Padding="10,6,6,6"
                                                        CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrushHover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                            <TextBlock Name="ToolbarPressureLabel"
                                       Text="{Binding ToolbarPressureLabelText}"
                                       FontSize="11"/>
                        </ToggleButton>
                        <Border Width="1"
                                Background="{StaticResource PanelBorderBrush}"
                                Margin="0,3"/>
                        <Button Name="ToolbarPressureCurveDropdown"
                                Click="ToolbarPressureCurveDropdown_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="Transparent"
                                                        Padding="6,6,8,6"
                                                        CornerRadius="8">
                                                    <Path Width="7"
                                                          Height="4"
                                                          Fill="{TemplateBinding Foreground}"
                                                          Data="M 0 0 L 7 0 L 3.5 4 Z"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldPressedBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        <Button.ContextMenu>
                            <ContextMenu Name="PressureCurveMenu">
                                <ContextMenu.Resources>
                                    <Style TargetType="ContextMenu">
                                        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ContextMenu">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="0,4">
                                                        <StackPanel IsItemsHost="True"
                                                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <Border x:Name="Bd"
                                                            Background="Transparent"
                                                            Padding="24,6,32,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="18"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ContentPresenter Grid.Column="0"
                                                                              ContentSource="Icon"
                                                                              VerticalAlignment="Center"/>
                                                            <ContentPresenter Grid.Column="1"
                                                                              ContentSource="Header"
                                                                              RecognizesAccessKey="True"
                                                                              VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem Header="Linear"
                                          Icon="{Binding IsPressureCurveLinearChecked, Converter={StaticResource BoolToCheckmarkConverter}}"
                                          Command="{Binding SelectPressureCurveLinearCommand}"/>
                                <MenuItem Header="Logarithmic"
                                          Icon="{Binding IsPressureCurveLogarithmicChecked, Converter={StaticResource BoolToCheckmarkConverter}}"
                                          Command="{Binding SelectPressureCurveLogarithmicCommand}"/>
                                <MenuItem Header="Exponential"
                                          Icon="{Binding IsPressureCurveExponentialChecked, Converter={StaticResource BoolToCheckmarkConverter}}"
                                          Command="{Binding SelectPressureCurveExponentialCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    </StackPanel>
                </Border>
                <Border x:Name="InputBackendSplitBorder"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="Transparent"
                        Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <Button Name="ToolbarInputBackendButton"
                                Style="{StaticResource ToolbarButton}"
                                Padding="8,4"
                                Command="{Binding CycleInputBackendCommand}">
                            <TextBlock Name="ToolbarInputBackendLabel"
                                       Text="{Binding ToolbarInputBackendLabelText}"
                                       FontSize="11"/>
                        </Button>
                        <Border Width="1"
                                Margin="2,3"
                                Background="{StaticResource PanelBorderBrush}"/>
                        <Button Style="{StaticResource ToolbarButton}"
                                Padding="6,4"
                                Click="ToolbarInputBackendDropdown_Click">
                    <TextBlock Text="▾"
                                        FontSize="11"
                                        Foreground="{StaticResource TextMutedBrush}"/>
                            <Button.ContextMenu>
                                <ContextMenu Name="InputBackendMenu"
                                             Background="{StaticResource SurfaceRaisedBrush}"
                                             BorderBrush="{StaticResource PanelBorderBrush}"
                                             BorderThickness="1">
                                    <ContextMenu.Resources>
                                        <Style TargetType="ContextMenu">
                                            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ContextMenu">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="0,4">
                                                            <StackPanel IsItemsHost="True"
                                                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="MenuItem">
                                                        <Border x:Name="Bd"
                                                                Background="Transparent"
                                                                Padding="24,6,32,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="18"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ContentPresenter Grid.Column="0"
                                                                                  ContentSource="Icon"
                                                                                  VerticalAlignment="Center"/>
                                                                <ContentPresenter Grid.Column="1"
                                                                                  ContentSource="Header"
                                                                                  RecognizesAccessKey="True"
                                                                                  VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ContextMenu.Resources>
                                    <MenuItem Header="Auto"
                                              Icon="{Binding IsInputBackendAutoChecked, Converter={StaticResource BoolToCheckmarkConverter}}"
                                              Command="{Binding SelectInputBackendAutoCommand}"/>
                                    <MenuItem Header="Wintab"
                                              Icon="{Binding IsInputBackendWintabChecked, Converter={StaticResource BoolToCheckmarkConverter}}"
                                              Command="{Binding SelectInputBackendWintabCommand}"/>
                                    <MenuItem Header="Mouse"
                                              Icon="{Binding IsInputBackendMouseChecked, Converter={StaticResource BoolToCheckmarkConverter}}"
                                              Command="{Binding SelectInputBackendMouseCommand}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Border>
                <ToggleButton Name="ToolbarZoneSwitchToggle"
                              Style="{StaticResource ToolbarToggle}"
                              Content="Latch On Enter"
                              IsChecked="{Binding AllowZoneSwitchWhilePressed, Mode=TwoWay}"/>
                <Border Style="{StaticResource ToolbarSep}"/>
                <ComboBox Name="TabletDeviceComboBox"
                          MinWidth="120"
                          VerticalAlignment="Center"
                          DisplayMemberPath="Label"
                          ItemsSource="{Binding TabletDevices}"
                          SelectedItem="{Binding SelectedTabletDevice, Mode=TwoWay}"
                          IsEnabled="{Binding IsTabletDevicePickerEnabled}"
                          SelectionChanged="TabletDeviceComboBox_SelectionChanged"/>
                <Button Style="{StaticResource ToolbarButton}"
                        Content="Reconnect"
                        Command="{Binding ReconnectPenCommand}"/>

            </StackPanel>

            <!-- right-aligned MIDI status -->
            <StackPanel Name="MidiStatusPanel"
                        DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Margin="12,0,4,0"
                        Visibility="{Binding IsMidiStatusPanelVisible, Converter={StaticResource BoolToVis}}">
                <ProgressBar Name="MidiProgressBar"
                             Width="60"
                             Height="3"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Foreground="{StaticResource AccentBrush}"
                             Background="{StaticResource SurfaceMutedBrush}"
                             Visibility="{Binding IsMidiProgressVisible, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Name="MidiStatusText"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Text="{Binding MidiStatusText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MidiStatusSeverity}" Value="{x:Static vm:MidiStatusSeverity.Error}">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Name="StatusText"
                           Grid.Column="0"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Text="{Binding StatusText}"/>

                <Border Grid.Column="1"
                        Width="1"
                        Background="{StaticResource PanelBorderBrush}"
                        Margin="12,0"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Name="ActiveZoneText"
                               Foreground="{StaticResource WarningBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Text="{Binding ActiveZoneText}"/>
                    <Border Width="1"
                            Background="{StaticResource PanelBorderBrush}"
                            Margin="12,0"
                            VerticalAlignment="Stretch"/>
                    <TextBlock Name="ValueText"
                               Foreground="{StaticResource TextSoftBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Text="{Binding ValueText}"/>
                    <Border Width="1"
                            Background="{StaticResource PanelBorderBrush}"
                            Margin="12,0"
                            VerticalAlignment="Stretch"/>
                    <TextBlock Name="PenButtonsText"
                               Foreground="{StaticResource SuccessBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Text="{Binding PenButtonsText}"/>
                    <Border Width="1"
                            Background="{StaticResource PanelBorderBrush}"
                            Margin="12,0"
                            VerticalAlignment="Stretch"/>
                    <TextBlock Name="ModifiersText"
                               Foreground="{StaticResource InfoBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Text="{Binding ModifiersText}"/>
                </StackPanel>

                <TextBlock Name="InputBackendText"
                           Grid.Column="3"
                           Foreground="{StaticResource AccentBrushHover}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Text="{Binding InputBackendText}"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Margin="8,8,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="312"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Zone editor panel -->
            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Zones"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <TextBlock Name="RoutingText"
                                   Foreground="{StaticResource TextSoftBrush}"
                                   FontSize="11"
                                   Margin="0,4,0,10"
                                   TextWrapping="Wrap"
                                   Text="{Binding RoutingText}"/>

                        <TextBlock Text="Layout"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Max Rows"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"/>
                                <TextBox Name="MaxZoneRowsTextBox"
                                         Margin="0,4,0,0"
                                         Text="{Binding MaxZoneRowsText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Max Per Row"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"/>
                                <TextBox Name="MaxZonesPerRowTextBox"
                                         Margin="0,4,0,0"
                                         Text="{Binding MaxZonesPerRowText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <ListBox Name="ZoneListBox"
                                 Height="132"
                                 ItemsSource="{Binding Zones}"
                                 SelectedIndex="{Binding SelectedZoneIndex, Mode=TwoWay}"
                                 DisplayMemberPath="DisplayText"
                                 SelectionChanged="ZoneListBox_SelectionChanged"/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Name="AddZoneButton"
                                    Grid.Column="0"
                                    Style="{StaticResource ZoneIconButtonStyle}"
                                    ToolTip="Add zone"
                                    Command="{Binding AddZoneCommand}"
                                    Content="+"/>

                            <Button Name="RemoveZoneButton"
                                    Grid.Column="2"
                                    Style="{StaticResource ZoneIconButtonStyle}"
                                    ToolTip="Remove selected zone"
                                    Command="{Binding RemoveZoneCommand}"
                                    Content="−"/>

                            <Button Name="AutoLayoutButton"
                                    Grid.Column="4"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="86"
                                    Command="{Binding AutoLayoutCommand}"
                                    Content="Auto Tile"/>
                        </Grid>

                        <!-- Selected zone properties -->
                        <Border Margin="0,12,0,0"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Selected Zone"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="ZoneNameTextBox"
                                             Grid.Column="0"
                                             Text="{Binding ZoneName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <ComboBox Name="ZoneChannelComboBox"
                                              Grid.Column="2"
                                              ItemsSource="{Binding MidiChannels}"
                                              SelectedItem="{Binding ZoneMidiChannel, Mode=TwoWay}"/>
                                    <CheckBox Name="ZoneEnabledCheckBox"
                                              Grid.Column="3"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding ZoneEnabled}"
                                              Content="On"/>
                                </Grid>
                                <Border Margin="0,8,0,0"
                                        Padding="10,8"
                                        Background="{StaticResource SurfaceRaisedBrush}"
                                        BorderBrush="{StaticResource PanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Name="ZoneSelectionSummaryPrimaryText"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding ZoneSelectionSummaryPrimaryText}"/>
                                        <TextBlock Name="ZoneSelectionSummarySecondaryText"
                                                   Foreground="{StaticResource TextSoftBrush}"
                                                   FontSize="10"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding ZoneSelectionSummarySecondaryText}"/>
                                    </StackPanel>
                                </Border>

                                <Expander Name="ZoneDetailsExpander"
                                          Margin="0,12,0,0"
                                          IsEnabled="{Binding ZoneDetailsEnabled}"
                                          IsExpanded="False">
                                    <Expander.Header>
                                        <TextBlock Text="Zone configuration"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                    </Expander.Header>
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="MIDI Mapping"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="CC X"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="11"/>
                                                <TextBox Name="ZoneCcXTextBox"
                                                         Margin="0,4,0,0"
                                                         Text="{Binding ZoneCcX, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="CC Y"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="11"/>
                                                <TextBox Name="ZoneCcYTextBox"
                                                         Margin="0,4,0,0"
                                                         Text="{Binding ZoneCcY, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="CC P"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="11"/>
                                                <TextBox Name="ZoneCcPressureTextBox"
                                                         Margin="0,4,0,0"
                                                         Text="{Binding ZoneCcPressure, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Bounds"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Margin="0,14,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Left"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="11"/>
                                                <TextBox Name="ZoneLeftTextBox"
                                                         Margin="0,4,0,0"
                                                         Text="{Binding ZoneLeft, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Top"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="11"/>
                                                <TextBox Name="ZoneTopTextBox"
                                                         Margin="0,4,0,0"
                                                         Text="{Binding ZoneTop, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="W"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="11"/>
                                                <TextBox Name="ZoneWidthTextBox"
                                                         Margin="0,4,0,0"
                                                         Text="{Binding ZoneWidth, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="6">
                                                <TextBlock Text="H"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="11"/>
                                                <TextBox Name="ZoneHeightTextBox"
                                                         Margin="0,4,0,0"
                                                         Text="{Binding ZoneHeight, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Options"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Margin="0,14,0,6"/>
                                        <CheckBox Name="ZoneSendXCheckBox"
                                                  IsChecked="{Binding ZoneSendX}"
                                                  Content="Send X"/>
                                        <CheckBox Name="ZoneSendYCheckBox"
                                                  Margin="0,6,0,0"
                                                  IsChecked="{Binding ZoneSendY}"
                                                  Content="Send Y"/>
                                        <CheckBox Name="ZoneInvertXCheckBox"
                                                  Margin="0,6,0,0"
                                                  IsChecked="{Binding ZoneInvertX}"
                                                  Content="Invert X"/>
                                        <CheckBox Name="ZoneInvertYCheckBox"
                                                  Margin="0,6,0,0"
                                                  IsChecked="{Binding ZoneInvertY}"
                                                  Content="Invert Y"/>
                                        <CheckBox Name="ZoneSendPressureCheckBox"
                                                  Margin="0,6,0,0"
                                                  IsChecked="{Binding ZoneSendPressure}"
                                                  Content="Send pressure"/>
                                        <TextBlock Text="Release Behavior"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"
                                                   Margin="0,10,0,0"/>
                                        <ComboBox Name="ZoneReleaseBehaviorComboBox"
                                                  ItemsSource="{Binding ReleaseBehaviorOptions}"
                                                  SelectedItem="{Binding ZoneReleaseBehavior, Mode=TwoWay}"
                                                  Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Button Margin="0,14,0,0"
                                Padding="10,7"
                                Command="{Binding SaveSettingsCommand}"
                                Content="Apply Settings"/>

                        <TextBlock Name="SettingsResultText"
                                   Margin="0,8,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="{Binding SettingsResultMessage}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SettingsResultKind}" Value="{x:Static vm:SettingsResultKind.Success}">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SettingsResultKind}" Value="{x:Static vm:SettingsResultKind.Error}">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Name="ConfigSummaryText"
                                   Foreground="{StaticResource TextFaintBrush}"
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="{Binding ConfigSummaryText}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Pad area (surface + overlay + cursor live in PadInteractionSurface) -->
            <views:PadInteractionSurface x:Name="PadSurface"
                                         Grid.Column="2"/>

            <!-- (loading overlay removed — MIDI init is non-blocking) -->
        </Grid>
    </DockPanel>
</Window>
