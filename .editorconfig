# Top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 4
charset = utf-8
end_of_line = crlf
insert_final_newline = true

# C# specific code style
[*.cs]
# Use file-scoped namespaces
csharp_style_namespace_declarations = file_scoped:suggestion

# Prefer expression-bodied members when possible
csharp_style_expression_bodied_methods = when_possible:suggestion
csharp_style_expression_bodied_properties = when_possible:suggestion

# Prefer var when type is apparent
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Prefer pattern matching
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion

# Code analysis severity
dotnet_diagnostic.CA1303.severity = none

# StyleCop rules adjustments
dotnet_diagnostic.SA1309.severity = none

# Treat analyzer diagnostics as warnings by default
dotnet_analyzer_diagnostic.severity = warning


[*.xaml]
indent_size = 2

