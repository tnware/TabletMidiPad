<Window x:Class="TabletMidiPad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tablet MIDI Pad"
        Width="700"
        Height="700"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#111111">
    <Grid Margin="16">
        <Border CornerRadius="12"
                BorderBrush="#444"
                BorderThickness="1"
                Background="#1b1b1b">
            <Grid>
                <Canvas Name="Pad"
                        Background="Transparent"
                        StylusDown="Pad_StylusDown"
                        StylusMove="Pad_StylusMove"
                        StylusUp="Pad_StylusUp"
                        MouseDown="Pad_MouseDown"
                        MouseMove="Pad_MouseMove"
                        MouseUp="Pad_MouseUp"/>
                <Ellipse Name="CursorDot"
                         Width="18"
                         Height="18"
                         Fill="#d0d0d0"
                         Opacity="0.9"
                         Visibility="Collapsed"/>
                <StackPanel VerticalAlignment="Top"
                            HorizontalAlignment="Left"
                            Margin="16">
                    <TextBlock Name="StatusText"
                               Foreground="#eaeaea"
                               FontSize="18"
                               Text="Waiting for MIDI port..."/>
                    <TextBlock Name="ValueText"
                               Foreground="#a8a8a8"
                               Margin="0,8,0,0"
                               FontSize="14"
                               Text="X: -, Y: -, Pressure: -"/>
                    <TextBlock Foreground="#7f7f7f"
                               Margin="0,12,0,0"
                               FontSize="12"
                               Text="Start this app before the DAW. In the DAW, use 'Tablet XY (DAW)' as the MIDI input."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
