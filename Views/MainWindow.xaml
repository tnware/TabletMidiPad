<Window x:Class="TabletMidiPad.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TabletMidiPad.ViewModels"
        Title="Tablet MIDI Pad"
        Width="1280"
        Height="780"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Icon="{StaticResource AppIcon}">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ZoneIconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="TopLevelMenuItemWithSub" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="10,5">
                            <Grid>
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"/>
                                <Popup x:Name="PART_Popup"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Bottom"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border Background="{StaticResource SurfaceRaisedBrush}"
                                            BorderBrush="{StaticResource PanelBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="0,4">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="24,8,32,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"/>
                                <TextBlock Grid.Column="1"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="{StaticResource TextSoftBrush}"
                                           Margin="24,0,0,0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Margin="8,4"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="0,1,0,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top"
              Background="{StaticResource SurfaceRaisedBrush}"
              Foreground="{StaticResource TextPrimaryBrush}"
              Padding="6,4">
            <MenuItem Header="_File"
                      Style="{StaticResource TopLevelMenuItemWithSub}">
                <MenuItem Header="_Save Settings"
                          Command="{Binding SaveCommand}"
                          InputGestureText="Ctrl+S"/>
                <MenuItem Header="_Reset to Defaults"
                          Command="{Binding ResetDefaultsCommand}"/>
                <Separator/>
                <MenuItem Header="_Preferences..."
                          Click="MenuPreferences_Click"/>
                <Separator/>
                <MenuItem Header="E_xit"
                          Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Device"
                      Style="{StaticResource TopLevelMenuItemWithSub}">
                <MenuItem Header="_Refresh Wacom Status"
                          Click="MenuRefreshWacom_Click"/>
                <MenuItem Header="Reconnect _Pen Input"
                          Command="{Binding ReconnectCommand}"/>
                <MenuItem Header="_Start Wacom Service"
                          Name="MenuStartWacomService"
                          Command="{Binding StartWacomServiceCommand}"/>
                <Separator/>
                <MenuItem Header="{Binding WacomServiceStatus}"
                          IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="_Help"
                      Style="{StaticResource TopLevelMenuItemWithSub}">
                <MenuItem Header="_About"
                          Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <Border.Resources>
                <Style x:Key="ToolbarButton" TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Padding" Value="10,6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}"
                                        CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldPressedBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="ToolbarToggle" TargetType="ToggleButton">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Padding" Value="10,6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        BorderBrush="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSurfaceBrush}"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrushHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="ToolbarSep" TargetType="Border">
                    <Setter Property="Width" Value="1"/>
                    <Setter Property="Background" Value="{StaticResource PanelBorderBrush}"/>
                    <Setter Property="Margin" Value="6,2"/>
                </Style>
            </Border.Resources>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButton}"
                        Content="Save"
                        Command="{Binding SaveCommand}"/>
                <Border Style="{StaticResource ToolbarSep}"/>
                <Button Style="{StaticResource ToolbarButton}"
                        Content="Add Zone"
                        Command="{Binding AddZoneCommand}"/>
                <Button Style="{StaticResource ToolbarButton}"
                        Content="Auto Tile"
                        Command="{Binding AutoTileCommand}"/>
                <Border Style="{StaticResource ToolbarSep}"/>
                <!-- Pressure split button: toggle + curve dropdown -->
                <Border x:Name="PressureSplitBorder"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="Transparent"
                        Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Name="ToolbarPressureToggle"
                                      IsChecked="{Binding SendPressureGlobally}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Bd"
                                                        Background="Transparent"
                                                        Padding="10,6,6,6"
                                                        CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrushHover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                            <TextBlock Text="{Binding PressureLabel}"
                                       FontSize="11"/>
                        </ToggleButton>
                        <Border Width="1"
                                Background="{StaticResource PanelBorderBrush}"
                                Margin="0,3"/>
                        <Button Name="ToolbarPressureCurveDropdown"
                                Click="ToolbarPressureCurveDropdown_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="Transparent"
                                                        Padding="6,6,8,6"
                                                        CornerRadius="8">
                                                    <Path Width="7"
                                                          Height="4"
                                                          Fill="{TemplateBinding Foreground}"
                                                          Data="M 0 0 L 7 0 L 3.5 4 Z"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldPressedBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        <Button.ContextMenu>
                            <ContextMenu Name="PressureCurveMenu">
                                <ContextMenu.Resources>
                                    <Style TargetType="ContextMenu">
                                        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ContextMenu">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="0,4">
                                                        <StackPanel IsItemsHost="True"
                                                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <Border x:Name="Bd"
                                                            Background="Transparent"
                                                            Padding="24,6,32,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="18"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ContentPresenter Grid.Column="0"
                                                                              ContentSource="Icon"
                                                                              VerticalAlignment="Center"/>
                                                            <ContentPresenter Grid.Column="1"
                                                                              ContentSource="Header"
                                                                              RecognizesAccessKey="True"
                                                                              VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem Header="Linear"
                                          Command="{Binding SetPressureCurveCommand}" CommandParameter="Linear"/>
                                <MenuItem Header="Logarithmic"
                                          Command="{Binding SetPressureCurveCommand}" CommandParameter="Logarithmic"/>
                                <MenuItem Header="Exponential"
                                          Command="{Binding SetPressureCurveCommand}" CommandParameter="Exponential"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    </StackPanel>
                </Border>
                <Border x:Name="InputBackendSplitBorder"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="Transparent"
                        Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <Button Name="ToolbarInputBackendButton"
                                Style="{StaticResource ToolbarButton}"
                                Padding="8,4"
                                Command="{Binding CycleInputBackendCommand}">
                            <TextBlock Text="{Binding InputBackendLabel}"
                                       FontSize="11"/>
                        </Button>
                        <Border Width="1"
                                Margin="2,3"
                                Background="{StaticResource PanelBorderBrush}"/>
                        <Button Style="{StaticResource ToolbarButton}"
                                Padding="6,4"
                                Click="ToolbarInputBackendDropdown_Click">
                    <TextBlock Text="▾"
                                        FontSize="11"
                                        Foreground="{StaticResource TextMutedBrush}"/>
                            <Button.ContextMenu>
                                <ContextMenu Name="InputBackendMenu"
                                             Background="{StaticResource SurfaceRaisedBrush}"
                                             BorderBrush="{StaticResource PanelBorderBrush}"
                                             BorderThickness="1">
                                    <ContextMenu.Resources>
                                        <Style TargetType="ContextMenu">
                                            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ContextMenu">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="0,4">
                                                            <StackPanel IsItemsHost="True"
                                                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="MenuItem">
                                                        <Border x:Name="Bd"
                                                                Background="Transparent"
                                                                Padding="24,6,32,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="18"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ContentPresenter Grid.Column="0"
                                                                                  ContentSource="Icon"
                                                                                  VerticalAlignment="Center"/>
                                                                <ContentPresenter Grid.Column="1"
                                                                                  ContentSource="Header"
                                                                                  RecognizesAccessKey="True"
                                                                                  VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ContextMenu.Resources>
                                    <MenuItem Header="Auto"
                                              Command="{Binding SetInputBackendModeCommand}" CommandParameter="Auto"/>
                                    <MenuItem Header="Wintab"
                                              Command="{Binding SetInputBackendModeCommand}" CommandParameter="Wintab Only"/>
                                    <MenuItem Header="Mouse"
                                              Command="{Binding SetInputBackendModeCommand}" CommandParameter="Stylus/Mouse Only"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Border>
                <ToggleButton Name="ToolbarZoneSwitchToggle"
                              Style="{StaticResource ToolbarToggle}"
                              Content="Latch On Enter"
                              IsChecked="{Binding AllowZoneSwitchWhilePressed}"/>
                <Border Style="{StaticResource ToolbarSep}"/>
                <Button Style="{StaticResource ToolbarButton}"
                        Content="Reconnect"
                        Command="{Binding ReconnectCommand}"/>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Text="{Binding StatusText}"/>

                <Border Grid.Column="1"
                        Width="1"
                        Background="{StaticResource PanelBorderBrush}"
                        Margin="12,0"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Foreground="{StaticResource WarningBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Text="{Binding ActiveZoneText}"/>
                    <Border Width="1"
                            Background="{StaticResource PanelBorderBrush}"
                            Margin="12,0"
                            VerticalAlignment="Stretch"/>
                    <TextBlock Foreground="{StaticResource TextSoftBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Text="{Binding ValueText}"/>
                    <Border Width="1"
                            Background="{StaticResource PanelBorderBrush}"
                            Margin="12,0"
                            VerticalAlignment="Stretch"/>
                    <TextBlock Foreground="{StaticResource SuccessBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Text="{Binding PenButtonsText}"/>
                    <Border Width="1"
                            Background="{StaticResource PanelBorderBrush}"
                            Margin="12,0"
                            VerticalAlignment="Stretch"/>
                    <TextBlock Foreground="{StaticResource InfoBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Text="{Binding ModifiersText}"/>
                </StackPanel>

                <TextBlock Grid.Column="3"
                           Foreground="{StaticResource AccentBrushHover}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Text="{Binding InputBackendText}"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Margin="8,8,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Zone editor panel -->
            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Zones"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <TextBlock Foreground="{StaticResource TextSoftBrush}"
                                   FontSize="11"
                                   Margin="0,4,0,10"
                                   TextWrapping="Wrap"
                                   Text="{Binding RoutingText}"/>

                        <TextBlock Text="Layout"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Max Rows"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"/>
                                <TextBox Margin="0,4,0,0"
                                         Text="{Binding Config.MaxZoneRows}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Max Per Row"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"/>
                                <TextBox Margin="0,4,0,0"
                                         Text="{Binding Config.MaxZonesPerRow}"/>
                            </StackPanel>
                        </Grid>

                        <ListBox Name="ZoneListBox"
                                 Height="120"
                                 ItemsSource="{Binding Zones}"
                                 SelectedIndex="{Binding SelectedZoneIndex}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Name}"/>
                                        <Run Text=" ["/><Run Text="{Binding Enabled, Converter={StaticResource BoolToVis}}"/><Run Text="]"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource ZoneIconButtonStyle}"
                                    ToolTip="Add zone"
                                    Command="{Binding AddZoneCommand}"
                                    Content="+"/>

                            <Button Grid.Column="2"
                                    Style="{StaticResource ZoneIconButtonStyle}"
                                    ToolTip="Remove selected zone"
                                    Command="{Binding RemoveZoneCommand}"
                                    Content="−"/>

                            <Button Grid.Column="4"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="86"
                                    Command="{Binding AutoTileCommand}"
                                    Content="Auto Tile"/>
                        </Grid>

                        <!-- Selected zone properties -->
                        <Border Margin="0,12,0,0"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding SelectedZone.Name}"/>
                                    <CheckBox Grid.Column="1"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              Content="On"
                                              IsChecked="{Binding SelectedZone.Enabled}"/>
                                </Grid>

                                <TextBlock Text="MIDI"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,14,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Ch"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"/>
                                        <ComboBox Margin="0,4,0,0"
                                                  SelectedItem="{Binding SelectedZone.MidiChannel}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CC X"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"/>
                                        <TextBox Margin="0,4,0,0"
                                                 Text="{Binding SelectedZone.CcX}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="CC Y"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"/>
                                        <TextBox Margin="0,4,0,0"
                                                 Text="{Binding SelectedZone.CcY}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="CC P"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"/>
                                        <TextBox Margin="0,4,0,0"
                                                 Text="{Binding SelectedZone.CcPressure}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Bounds"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,14,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Left"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"/>
                                        <TextBox Margin="0,4,0,0"
                                                 Text="{Binding SelectedZone.Left, StringFormat=\{0:0.###\}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Top"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"/>
                                        <TextBox Margin="0,4,0,0"
                                                 Text="{Binding SelectedZone.Top, StringFormat=\{0:0.###\}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="W"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"/>
                                        <TextBox Margin="0,4,0,0"
                                                 Text="{Binding SelectedZone.Width, StringFormat=\{0:0.###\}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="H"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"/>
                                        <TextBox Margin="0,4,0,0"
                                                 Text="{Binding SelectedZone.Height, StringFormat=\{0:0.###\}}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Options"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,14,0,6"/>
                                <CheckBox Content="Send X" IsChecked="{Binding SelectedZone.SendX}"/>
                                <CheckBox Margin="0,6,0,0"
                                          Content="Send Y" IsChecked="{Binding SelectedZone.SendY}"/>
                                <CheckBox Margin="0,6,0,0"
                                          Content="Invert X" IsChecked="{Binding SelectedZone.InvertX}"/>
                                <CheckBox Margin="0,6,0,0"
                                          Content="Invert Y" IsChecked="{Binding SelectedZone.InvertY}"/>
                                <CheckBox Margin="0,6,0,0"
                                          Content="Send pressure" IsChecked="{Binding SelectedZone.SendPressure}"/>
                                <TextBlock Text="Release Behavior"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           Margin="0,10,0,0"/>
                                <ComboBox Margin="0,6,0,0" SelectedValue="{Binding SelectedZone.ReleaseBehavior}"/>
                            </StackPanel>
                        </Border>

                        <Button Margin="0,14,0,0"
                                Padding="10,7"
                                Command="{Binding SaveCommand}"
                                Content="Apply Settings"/>

                        <TextBlock Foreground="{StaticResource SuccessBrush}"
                                   Margin="0,8,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="{Binding SettingsResultText}"/>

                        <TextBlock Foreground="{StaticResource TextFaintBrush}"
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="{Binding ConfigSummaryText}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Pad area -->
            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Canvas Name="Pad"
                            Background="Transparent"
                            SizeChanged="Pad_SizeChanged"
                            StylusDown="Pad_StylusDown"
                            StylusMove="Pad_StylusMove"
                            StylusUp="Pad_StylusUp"
                            MouseDown="Pad_MouseDown"
                            MouseMove="Pad_MouseMove"
                            MouseUp="Pad_MouseUp"/>

                    <Canvas Name="ZoneOverlayCanvas"
                            IsHitTestVisible="False"/>

                    <Ellipse Name="CursorDot"
                             Width="14"
                             Height="14"
                             Fill="{StaticResource AccentBrushHover}"
                             Opacity="0.85"
                             Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Loading overlay -->
            <Grid Grid.ColumnSpan="3"
                  Background="{StaticResource OverlayBrush}"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <Border Width="400"
                        Padding="28"
                        CornerRadius="16"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Tablet MIDI Pad"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Preparing controller surfaces and MIDI routing"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,8,0,0"
                                   FontSize="13"
                                   HorizontalAlignment="Center"/>
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding LoadingProgress}"
                                     Height="4"
                                     Margin="0,22,0,0"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="{StaticResource SurfaceMutedBrush}"/>
                        <TextBlock Text="{Binding LoadingTitle}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,18,0,0"
                                   FontSize="14"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding LoadingDetail}"
                                   Foreground="{StaticResource TextSoftBrush}"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
