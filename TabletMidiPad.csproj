<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Enable built-in .NET analyzers and enforce code style during build -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="teVirtualMIDI.cs" />
    <Compile Remove="wacom-device-kit-windows\**\*.cs" />
    <Compile Remove="TabletMidiPad.Tests\**\*.cs" />
    <EmbeddedResource Remove="wacom-device-kit-windows\**\*" />
    <None Remove="wacom-device-kit-windows\**\*" />
    <Page Remove="wacom-device-kit-windows\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <!-- StyleCop static analysis. Marked as PrivateAssets so it doesn't flow to consumers. -->
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- If an application icon is added to Assets\app.ico, embed it as the application icon. This is conditional
       so builds won't fail when the asset hasn't been added yet. Replace with a proper .ico when available. -->
  <PropertyGroup Condition="Exists('Assets\\app.ico')">
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- If a PNG icon is added at Assets\icon.png, include it as a resource so WPF pack URIs can reference it. -->
  <ItemGroup Condition="Exists('Assets\\icon.png')">
    <Resource Include="Assets\icon.png" />
  </ItemGroup>

  <!-- Multi-size ICO for Window.Icon (lets the shell pick 16/32/48/256 instead of scaling one huge PNG). -->
  <ItemGroup Condition="Exists('Assets\\app.ico')">
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
