<Window x:Class="TabletMidiPad.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:TabletMidiPad.Views"
        xmlns:vm="clr-namespace:TabletMidiPad.ViewModels"
        mc:Ignorable="d"
        Title="Tablet MIDI Pad"
        Width="1280"
        Height="780"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Icon="{DynamicResource AppIcon}">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveCommand_Executed"/>
    </Window.CommandBindings>
    <Window.Resources>
        <Style x:Key="ZoneIconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"/>

        <Style x:Key="ZoneListStyle" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Padding" Value="6"/>
        </Style>

        <Style x:Key="ZoneListBoxItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <DataTemplate x:Key="ZoneListItemTemplate" DataType="{x:Type vm:ZoneListItemViewModel}">
            <Grid Margin="8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,8,0"
                               Text="&#xE81E;"/>
                    <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="{Binding DisplayIndex, StringFormat=Zone {0}}"/>
                    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               FontSize="12"
                               Margin="8,0,0,0"
                               Text="{Binding Name}"/>
                </StackPanel>
                <Border x:Name="StatusBadge"
                        Grid.Column="1"
                        CornerRadius="4"
                        Padding="6,1"
                        Background="{DynamicResource AccentFillColorTertiaryBrush}"
                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                        BorderThickness="1">
                    <TextBlock x:Name="StatusBadgeText"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                               Text="{Binding StatusText}"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                    <Setter TargetName="StatusBadge" Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                    <Setter TargetName="StatusBadgeText" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="PageListItemTemplate" DataType="{x:Type vm:PageListItemViewModel}">
            <Grid Margin="8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,8,0"
                               Text="&#xE8A5;"/>
                    <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="{Binding Name}"/>
                </StackPanel>
                <Border Grid.Column="1"
                        CornerRadius="4"
                        Padding="6,1"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <TextBlock FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding DisplayIndex, StringFormat=Page {0}}"/>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <Border.Resources>
                <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="10,6"/>
                </Style>
                <Style x:Key="ToolbarToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="10,6"/>
                </Style>
                <Style x:Key="ToolbarSep" TargetType="Border">
                    <Setter Property="Width" Value="1"/>
                    <Setter Property="Background" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                    <Setter Property="Margin" Value="6,2"/>
                </Style>
            </Border.Resources>
            <DockPanel>
            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Left">
                <Button Style="{StaticResource ToolbarButton}"
                        Padding="8,6"
                        Command="{Binding ShellCommands.OpenPreferencesCommand}"
                        ToolTip="Preferences">
                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                               FontSize="14"
                               Text="&#xE713;"/>
                </Button>
                <Border Style="{StaticResource ToolbarSep}"/>
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding ShellCommands.SaveSettingsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="13"
                                   Margin="0,0,6,0"
                                   Text="&#xE74E;"/>
                        <TextBlock Text="Save"/>
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource ToolbarSep}"/>
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding ZoneList.AddZoneCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="13"
                                   Margin="0,0,6,0"
                                   Text="&#xE710;"/>
                        <TextBlock Text="Add Zone"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding ZoneList.AutoLayoutCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="13"
                                   Margin="0,0,6,0"
                                   Text="&#xECA5;"/>
                        <TextBlock Text="Auto Tile"/>
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource ToolbarSep}"/>
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding ZoneList.PreviousPageCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="13"
                                   Margin="0,0,6,0"
                                   Text="&#xE72B;"/>
                        <TextBlock Text="Prev Page"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding ZoneList.NextPageCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="13"
                                   Margin="0,0,6,0"
                                   Text="&#xE72A;"/>
                        <TextBlock Text="Next Page"/>
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource ToolbarSep}"/>
                <!-- Pressure split button: toggle + curve dropdown -->
                <Border x:Name="PressureSplitBorder"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="Transparent"
                        Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                <ToggleButton Name="ToolbarPressureToggle"
                              Style="{StaticResource ToolbarToggle}"
                              Padding="10,6,6,6"
                              IsChecked="{Binding Toolbar.SendPressureGlobally, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="12"
                                           Margin="0,0,6,0"
                                           Text="&#xE76D;"/>
                                <TextBlock Name="ToolbarPressureLabel"
                                           Text="{Binding Toolbar.ToolbarPressureLabelText}"
                                           FontSize="11"/>
                            </StackPanel>
                        </ToggleButton>
                        <Border Width="1"
                                Background="{DynamicResource CardStrokeColorDefaultBrush}"
                                Margin="0,3"/>
                        <Button Name="ToolbarPressureCurveDropdown"
                                Style="{StaticResource ToolbarButton}"
                                Padding="6,6,8,6"
                                Click="ToolbarPressureCurveDropdown_Click">
                            <Path Width="7"
                                  Height="4"
                                  Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                  Data="M 0 0 L 7 0 L 3.5 4 Z"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"/>
                        <Button.ContextMenu>
                            <ContextMenu Name="PressureCurveMenu">
                                <MenuItem Header="Linear"
                                          Icon="{Binding Toolbar.IsPressureCurveLinearChecked, Converter={StaticResource BoolToCheckmarkConverter}}"
                                          Command="{Binding Toolbar.SelectPressureCurveLinearCommand}"/>
                                <MenuItem Header="Logarithmic"
                                          Icon="{Binding Toolbar.IsPressureCurveLogarithmicChecked, Converter={StaticResource BoolToCheckmarkConverter}}"
                                          Command="{Binding Toolbar.SelectPressureCurveLogarithmicCommand}"/>
                                <MenuItem Header="Exponential"
                                          Icon="{Binding Toolbar.IsPressureCurveExponentialChecked, Converter={StaticResource BoolToCheckmarkConverter}}"
                                          Command="{Binding Toolbar.SelectPressureCurveExponentialCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    </StackPanel>
                </Border>
                <Border x:Name="InputBackendSplitBorder"
                        Margin="6,0,0,0"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="Transparent"
                        Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <Button Name="ToolbarInputBackendButton"
                                Style="{StaticResource ToolbarButton}"
                                Padding="8,4"
                                Command="{Binding Toolbar.CycleInputBackendCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="12"
                                           Margin="0,0,6,0"
                                           Text="&#xE7C9;"/>
                                <TextBlock Name="ToolbarInputBackendLabel"
                                           Text="{Binding Toolbar.ToolbarInputBackendLabelText}"
                                           FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Border Width="1"
                                Margin="2,3"
                                Background="{DynamicResource CardStrokeColorDefaultBrush}"/>
                        <Button Style="{StaticResource ToolbarButton}"
                                Padding="6,4"
                                Click="ToolbarInputBackendDropdown_Click">
                            <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       Text="&#xE70D;"
                                       FontSize="12"/>
                            <Button.ContextMenu>
                                <ContextMenu Name="InputBackendMenu">
                                    <MenuItem Header="Auto"
                                              Icon="{Binding Toolbar.IsInputBackendAutoChecked, Converter={StaticResource BoolToCheckmarkConverter}}"
                                              Command="{Binding Toolbar.SelectInputBackendAutoCommand}"/>
                                    <MenuItem Header="Wintab"
                                              Icon="{Binding Toolbar.IsInputBackendWintabChecked, Converter={StaticResource BoolToCheckmarkConverter}}"
                                              Command="{Binding Toolbar.SelectInputBackendWintabCommand}"/>
                                    <MenuItem Header="Mouse"
                                              Icon="{Binding Toolbar.IsInputBackendMouseChecked, Converter={StaticResource BoolToCheckmarkConverter}}"
                                              Command="{Binding Toolbar.SelectInputBackendMouseCommand}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Border>
                <ToggleButton Name="ToolbarZoneSwitchToggle"
                              Margin="6,0,0,0"
                              Style="{StaticResource ToolbarToggle}"
                              IsChecked="{Binding Toolbar.AllowZoneSwitchWhilePressed, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="12"
                                   Margin="0,0,6,0"
                                   Text="&#xE718;"/>
                        <TextBlock Text="Latch On Enter"/>
                    </StackPanel>
                </ToggleButton>
                <Border Style="{StaticResource ToolbarSep}"/>
                <ComboBox Name="TabletDeviceComboBox"
                          MinWidth="120"
                          VerticalAlignment="Center"
                          DisplayMemberPath="Label"
                          ItemsSource="{Binding TabletDevices}"
                          SelectedItem="{Binding SelectedTabletDevice, Mode=TwoWay}"
                          IsEnabled="{Binding IsTabletDevicePickerEnabled}"
                          SelectionChanged="TabletDeviceComboBox_SelectionChanged"/>
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding ShellCommands.ReconnectPenCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="13"
                                   Margin="0,0,6,0"
                                   Text="&#xE72C;"/>
                        <TextBlock Text="Reconnect"/>
                    </StackPanel>
                </Button>

            </StackPanel>

            <!-- Right-aligned MIDI status -->
            <StackPanel Name="MidiStatusPanel"
                        DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        Visibility="{Binding IsMidiStatusPanelVisible, Converter={StaticResource BoolToVis}}">
                <ProgressBar Name="MidiProgressBar"
                             Width="60"
                             Height="3"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                             Background="{DynamicResource ControlFillColorDefaultBrush}"
                             Visibility="{Binding IsMidiProgressVisible, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Name="MidiStatusText"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Text="{Binding MidiStatusText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MidiStatusSeverity}" Value="{x:Static vm:MidiStatusSeverity.Error}">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Name="StatusText"
                           Grid.Column="0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Text="{Binding StatusText}"/>

                <Border Grid.Column="1"
                        Width="1"
                        Background="{DynamicResource CardStrokeColorDefaultBrush}"
                        Margin="12,0"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Name="ActiveZoneText"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Text="{Binding ActiveZoneText}"/>
                    <Border Width="1"
                            Background="{DynamicResource CardStrokeColorDefaultBrush}"
                            Margin="12,0"
                            VerticalAlignment="Stretch"/>
                    <TextBlock Name="ValueText"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Text="{Binding ValueText}"/>
                    <Border Width="1"
                            Background="{DynamicResource CardStrokeColorDefaultBrush}"
                            Margin="12,0"
                            VerticalAlignment="Stretch"/>
                    <TextBlock Name="PenButtonsText"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Text="{Binding PenButtonsText}"/>
                    <Border Width="1"
                            Background="{DynamicResource CardStrokeColorDefaultBrush}"
                            Margin="12,0"
                            VerticalAlignment="Stretch"/>
                    <TextBlock Name="ModifiersText"
                               Foreground="{DynamicResource SystemFillColorAttentionBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Text="{Binding ModifiersText}"/>
                </StackPanel>

                <TextBlock Name="InputBackendText"
                           Grid.Column="3"
                           Foreground="{DynamicResource AccentFillColorSecondaryBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Text="{Binding InputBackendText}"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="312"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Zone editor panel -->
            <Border Grid.Column="0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="16">
                    <StackPanel>
                        <TextBlock Text="Zones"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <TextBlock Name="RoutingText"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   FontSize="11"
                                   Margin="0,4,0,10"
                                   TextWrapping="Wrap"
                                   Text="{Binding RoutingText}"/>

                        <TextBlock Text="Pages"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <ListBox Name="PageListBox"
                                 Height="94"
                                 ItemContainerStyle="{StaticResource ZoneListBoxItemStyle}"
                                 ItemTemplate="{StaticResource PageListItemTemplate}"
                                 ItemsSource="{Binding ZoneEditor.Pages}"
                                 SelectedIndex="{Binding ZoneEditor.SelectedPageIndex, Mode=TwoWay}"
                                 SelectionChanged="PageListBox_SelectionChanged"
                                 Style="{StaticResource ZoneListStyle}"/>
                        <Grid Margin="0,8,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource ZoneIconButtonStyle}"
                                    ToolTip="Previous page"
                                    Command="{Binding ZoneList.PreviousPageCommand}"
                                    Content="&#xE72B;"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"/>
                            <Button Grid.Column="2"
                                    Style="{StaticResource ZoneIconButtonStyle}"
                                    ToolTip="Next page"
                                    Command="{Binding ZoneList.NextPageCommand}"
                                    Content="&#xE72A;"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"/>
                            <Button Grid.Column="4"
                                    Style="{StaticResource ZoneIconButtonStyle}"
                                    ToolTip="Add page"
                                    Command="{Binding ZoneList.AddPageCommand}"
                                    Content="&#xE710;"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"/>
                            <Button Grid.Column="6"
                                    Style="{StaticResource ZoneIconButtonStyle}"
                                    ToolTip="Remove selected page"
                                    Command="{Binding ZoneList.RemovePageCommand}"
                                    Content="&#xE74D;"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"/>
                            <TextBox Grid.Column="8"
                                     Margin="0,0,0,0"
                                     Text="{Binding ZoneEditor.PageName, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <TextBlock Text="Layout"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Max Rows"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="11"/>
                                <TextBox Name="MaxZoneRowsTextBox"
                                         Margin="0,4,0,0"
                                         Text="{Binding ZoneEditor.MaxZoneRowsText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Max Per Row"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="11"/>
                                <TextBox Name="MaxZonesPerRowTextBox"
                                         Margin="0,4,0,0"
                                         Text="{Binding ZoneEditor.MaxZonesPerRowText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <ListBox Name="ZoneListBox"
                                 Height="132"
                                 ItemContainerStyle="{StaticResource ZoneListBoxItemStyle}"
                                 ItemTemplate="{StaticResource ZoneListItemTemplate}"
                                 ItemsSource="{Binding ZoneEditor.Zones}"
                                 SelectedIndex="{Binding ZoneEditor.SelectedZoneIndex, Mode=TwoWay}"
                                 SelectionChanged="ZoneListBox_SelectionChanged"
                                 Style="{StaticResource ZoneListStyle}"/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Name="AddZoneButton"
                                    Grid.Column="0"
                                    Style="{StaticResource ZoneIconButtonStyle}"
                                    ToolTip="Add zone"
                                    Command="{Binding ZoneList.AddZoneCommand}"
                                    Content="&#xE710;"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"/>

                            <Button Name="RemoveZoneButton"
                                    Grid.Column="2"
                                    Style="{StaticResource ZoneIconButtonStyle}"
                                    ToolTip="Remove selected zone"
                                    Command="{Binding ZoneList.RemoveZoneCommand}"
                                    Content="&#xE74D;"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"/>

                            <Button Name="AutoLayoutButton"
                                    Grid.Column="6"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="86"
                                    Command="{Binding ZoneList.AutoLayoutCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                               FontSize="13"
                                               Margin="0,0,6,0"
                                               Text="&#xECA5;"/>
                                    <TextBlock Text="Auto Tile"/>
                                </StackPanel>
                            </Button>

                            <CheckBox Name="LockCanvasCheckBox"
                                      Grid.Column="4"
                                      Margin="0,0,4,0"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      IsChecked="{Binding ZoneEditor.IsCanvasLocked, Mode=TwoWay}"
                                      Content="Lock Canvas"/>
                        </Grid>

                        <!-- Selected zone properties -->
                        <Border Margin="0,12,0,0"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Selected Zone"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="ZoneNameTextBox"
                                             Grid.Column="0"
                                             Text="{Binding ZoneEditor.ZoneName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <ComboBox Name="ZoneChannelComboBox"
                                              Grid.Column="2"
                                              ItemsSource="{Binding ZoneEditor.MidiChannels}"
                                              SelectedItem="{Binding ZoneEditor.ZoneMidiChannel, Mode=TwoWay}"/>
                                    <CheckBox Name="ZoneEnabledCheckBox"
                                              Grid.Column="3"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding ZoneEditor.ZoneEnabled}"
                                              Content="On"/>
                                </Grid>
                                <Border Margin="0,8,0,0"
                                        Padding="10,8"
                                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Name="ZoneSelectionSummaryPrimaryText"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding ZoneEditor.ZoneSelectionSummaryPrimaryText}"/>
                                        <TextBlock Name="ZoneSelectionSummarySecondaryText"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   FontSize="10"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding ZoneEditor.ZoneSelectionSummarySecondaryText}"/>
                                    </StackPanel>
                                </Border>

                                <Expander Name="ZoneDetailsExpander"
                                          Margin="0,12,0,0"
                                          IsEnabled="{Binding ZoneEditor.ZoneDetailsEnabled}"
                                          IsExpanded="False">
                                    <Expander.Header>
                                        <TextBlock Text="Zone configuration"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                    </Expander.Header>
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="Output Mode"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="11"/>
                                        <ComboBox Margin="0,6,0,0"
                                                  ItemsSource="{Binding ZoneEditor.ZoneOutputModeOptions}"
                                                  SelectedItem="{Binding ZoneEditor.ZoneOutputMode, Mode=TwoWay}"/>

                                        <Border Margin="0,12,0,0"
                                                Padding="10,8"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Background="{DynamicResource LayerFillColorDefaultBrush}"
                                                CornerRadius="8">
                                            <StackPanel>
                                                <TextBlock Text="CC / Modulation Routing"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="CC X"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   FontSize="11"/>
                                                        <TextBox Name="ZoneCcXTextBox"
                                                                 Margin="0,4,0,0"
                                                                 Text="{Binding ZoneEditor.ZoneCcX, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <Button Margin="0,6,0,0"
                                                                Padding="8,4"
                                                                Click="ZoneLearnCcXButton_Click"
                                                                Content="Learn CC X"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="CC Y"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   FontSize="11"/>
                                                        <TextBox Name="ZoneCcYTextBox"
                                                                 Margin="0,4,0,0"
                                                                 Text="{Binding ZoneEditor.ZoneCcY, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <Button Margin="0,6,0,0"
                                                                Padding="8,4"
                                                                Click="ZoneLearnCcYButton_Click"
                                                                Content="Learn CC Y"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="CC P"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   FontSize="11"/>
                                                        <TextBox Name="ZoneCcPressureTextBox"
                                                                 Margin="0,4,0,0"
                                                                 Text="{Binding ZoneEditor.ZoneCcPressure, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <Button Margin="0,6,0,0"
                                                                Padding="8,4"
                                                                Click="ZoneLearnCcPressureButton_Click"
                                                                Content="Learn CC P"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Margin="0,12,0,0"
                                                Padding="10,8"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Background="{DynamicResource LayerFillColorDefaultBrush}"
                                                CornerRadius="8">
                                            <StackPanel>
                                                <TextBlock Text="MIDI Learn Assist"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,6"/>
                                                <CheckBox IsChecked="{Binding ZoneEditor.MappingAssistEnabled}"
                                                          Content="Solo one controller stream for MIDI learn"/>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               VerticalAlignment="Center"
                                                               Text="Target"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               FontSize="11"/>
                                                    <ComboBox Grid.Column="2"
                                                              ItemsSource="{Binding ZoneEditor.MappingAssistTargetOptions}"
                                                              SelectedItem="{Binding ZoneEditor.MappingAssistTarget, Mode=TwoWay}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Margin="0,12,0,0"
                                                Padding="10,8"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Background="{DynamicResource LayerFillColorDefaultBrush}"
                                                CornerRadius="8"
                                                Visibility="{Binding ZoneEditor.IsScaleBreathMode, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="Scale Breath Settings"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Root (0-11)"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   FontSize="11"/>
                                                        <TextBox Name="ZoneScaleBreathRootTextBox"
                                                                 Margin="0,4,0,0"
                                                                 Text="{Binding ZoneEditor.ScaleBreathRootText, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Scale"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   FontSize="11"/>
                                                        <ComboBox Margin="0,4,0,0"
                                                                  ItemsSource="{Binding ZoneEditor.ScaleBreathScaleOptions}"
                                                                  SelectedItem="{Binding ZoneEditor.ScaleBreathScale, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="Octave (0-8)"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   FontSize="11"/>
                                                        <TextBox Name="ZoneScaleBreathOctaveTextBox"
                                                                 Margin="0,4,0,0"
                                                                 Text="{Binding ZoneEditor.ScaleBreathOctaveText, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Hole Count (4-16)"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   FontSize="11"/>
                                                        <TextBox Name="ZoneScaleBreathHoleCountTextBox"
                                                                 Margin="0,4,0,0"
                                                                 Text="{Binding ZoneEditor.ScaleBreathHoleCountText, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Row Split (0.1-0.9)"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   FontSize="11"/>
                                                        <TextBox Name="ZoneScaleBreathRowSplitTextBox"
                                                                 Margin="0,4,0,0"
                                                                 Text="{Binding ZoneEditor.ScaleBreathRowSplitText, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <CheckBox Margin="0,8,0,0"
                                                          IsChecked="{Binding ZoneEditor.ScaleBreathSendCc}"
                                                          Content="Send CC modulation while in Scale Breath"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Margin="0,12,0,0"
                                                Padding="10,8"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Background="{DynamicResource LayerFillColorDefaultBrush}"
                                                CornerRadius="8"
                                                Visibility="{Binding ZoneEditor.IsScaleGridMode, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="Scale Grid Settings"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Root (0-11)"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   FontSize="11"/>
                                                        <TextBox Name="ZoneScaleGridRootTextBox"
                                                                 Margin="0,4,0,0"
                                                                 Text="{Binding ZoneEditor.ScaleGridRootText, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Scale"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   FontSize="11"/>
                                                        <ComboBox Margin="0,4,0,0"
                                                                  ItemsSource="{Binding ZoneEditor.ScaleBreathScaleOptions}"
                                                                  SelectedItem="{Binding ZoneEditor.ScaleGridScale, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="Octave (0-8)"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   FontSize="11"/>
                                                        <TextBox Name="ZoneScaleGridOctaveTextBox"
                                                                 Margin="0,4,0,0"
                                                                 Text="{Binding ZoneEditor.ScaleGridOctaveText, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Rows (1-16)"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   FontSize="11"/>
                                                        <TextBox Name="ZoneScaleGridRowsTextBox"
                                                                 Margin="0,4,0,0"
                                                                 Text="{Binding ZoneEditor.ScaleGridRowsText, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Columns (1-16)"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   FontSize="11"/>
                                                        <TextBox Name="ZoneScaleGridColumnsTextBox"
                                                                 Margin="0,4,0,0"
                                                                 Text="{Binding ZoneEditor.ScaleGridColumnsText, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <CheckBox Margin="0,8,0,0"
                                                          IsChecked="{Binding ZoneEditor.ScaleGridSendCc}"
                                                          Content="Send CC modulation while in Scale Grid"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="Bounds"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Margin="0,14,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Left"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           FontSize="11"/>
                                                <TextBox Name="ZoneLeftTextBox"
                                                         Margin="0,4,0,0"
                                                         Text="{Binding ZoneEditor.ZoneLeft, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Top"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           FontSize="11"/>
                                                <TextBox Name="ZoneTopTextBox"
                                                         Margin="0,4,0,0"
                                                         Text="{Binding ZoneEditor.ZoneTop, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="W"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           FontSize="11"/>
                                                <TextBox Name="ZoneWidthTextBox"
                                                         Margin="0,4,0,0"
                                                         Text="{Binding ZoneEditor.ZoneWidth, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="6">
                                                <TextBlock Text="H"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           FontSize="11"/>
                                                <TextBox Name="ZoneHeightTextBox"
                                                         Margin="0,4,0,0"
                                                         Text="{Binding ZoneEditor.ZoneHeight, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Options"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Margin="0,14,0,6"/>
                                        <CheckBox Name="ZoneSendXCheckBox"
                                                  IsChecked="{Binding ZoneEditor.ZoneSendX}"
                                                  Content="Send X"/>
                                        <CheckBox Name="ZoneSendYCheckBox"
                                                  Margin="0,6,0,0"
                                                  IsChecked="{Binding ZoneEditor.ZoneSendY}"
                                                  Content="Send Y"/>
                                        <CheckBox Name="ZoneInvertXCheckBox"
                                                  Margin="0,6,0,0"
                                                  IsChecked="{Binding ZoneEditor.ZoneInvertX}"
                                                  Content="Invert X"/>
                                        <CheckBox Name="ZoneInvertYCheckBox"
                                                  Margin="0,6,0,0"
                                                  IsChecked="{Binding ZoneEditor.ZoneInvertY}"
                                                  Content="Invert Y"/>
                                        <CheckBox Name="ZoneSendPressureCheckBox"
                                                  Margin="0,6,0,0"
                                                  IsChecked="{Binding ZoneEditor.ZoneSendPressure}"
                                                  Content="Send pressure"/>
                                        <TextBlock Text="Release Behavior"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="11"
                                                   Margin="0,10,0,0"/>
                                        <ComboBox Name="ZoneReleaseBehaviorComboBox"
                                                  ItemsSource="{Binding ZoneEditor.ReleaseBehaviorOptions}"
                                                  SelectedItem="{Binding ZoneEditor.ZoneReleaseBehavior, Mode=TwoWay}"
                                                  Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Button Margin="0,14,0,0"
                                Padding="10,7"
                                Command="{Binding ShellCommands.SaveSettingsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="13"
                                           Margin="0,0,6,0"
                                           Text="&#xE713;"/>
                                <TextBlock Text="Apply Settings"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Name="SettingsResultText"
                                   Margin="0,8,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="{Binding SettingsResultMessage}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SettingsResultKind}" Value="{x:Static vm:SettingsResultKind.Success}">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SettingsResultKind}" Value="{x:Static vm:SettingsResultKind.Error}">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Name="ConfigSummaryText"
                                   Foreground="{DynamicResource TextFillColorDisabledBrush}"
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="{Binding ConfigSummaryText}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Pad area (surface + overlay + cursor live in PadInteractionSurface) -->
            <views:PadInteractionSurface x:Name="PadSurface"
                                         Grid.Column="2"/>

            <!-- (loading overlay removed — MIDI init is non-blocking) -->
        </Grid>
    </DockPanel>
</Window>
