<Application x:Class="TabletMidiPad.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TabletMidiPad"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ThemeResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- If Assets/icon.png exists, expose it as a resource for Window icons. Use pack URI: \n                 Icon="pack://application:,,,/Assets/icon.png" on a Window. -->
            <BitmapImage x:Key="AppIcon" UriSource="pack://application:,,,/Assets/icon.png"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
