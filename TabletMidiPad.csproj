<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Release version: edit this only. Drives assembly / Explorer file details, About box, and NSIS (via generated installer/VersionDefines.generated.nsh). -->
    <Version>1.0.0</Version>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Enable built-in .NET analyzers and enforce code style during build -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="teVirtualMIDI.cs" />
    <Compile Remove="wacom-device-kit-windows\**\*.cs" />
    <Compile Remove="TabletMidiPad.Core\**\*.cs" />
    <Compile Remove="TabletMidiPad.Tests\**\*.cs" />
    <EmbeddedResource Remove="wacom-device-kit-windows\**\*" />
    <None Remove="wacom-device-kit-windows\**\*" />
    <Page Remove="wacom-device-kit-windows\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <!-- Try adding a known available StyleCop.Analyzers prerelease version. If this package
         isn't available in your feed or you prefer a stable release, replace with a compatible version. -->
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="TabletMidiPad.Core\TabletMidiPad.Core.csproj" />
  </ItemGroup>

  <!-- If an application icon is added to Assets\app.ico, embed it as the application icon. This is conditional
       so builds won't fail when the asset hasn't been added yet. Replace with a proper .ico when available. -->
  <PropertyGroup Condition="Exists('Assets\\app.ico')">
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- If a PNG icon is added at Assets\icon.png, include it as a resource so WPF pack URIs can reference it. -->
  <ItemGroup Condition="Exists('Assets\\icon.png')">
    <Resource Include="Assets\icon.png" />
  </ItemGroup>

  <!-- Multi-size ICO for Window.Icon (lets the shell pick 16/32/48/256 instead of scaling one huge PNG). -->
  <ItemGroup Condition="Exists('Assets\\app.ico')">
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <Target Name="WriteNsisVersionHeader" BeforeTargets="BeforeBuild">
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\installer\VersionDefines.generated.nsh"
                      Lines="!define APP_VERSION &quot;$(Version)&quot;"
                      Overwrite="true"
                      Encoding="UTF-8" />
  </Target>

</Project>
